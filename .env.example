# PowerShell: đọc README để nạp các biến này trước khi chạy Maven.
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
# Script start-local-server.ps1 tự đặt DB_URL đến server/data trong clone nếu chưa có biến này.
# Nếu chạy Maven/JAR thủ công, đường dẫn tương đối tính từ thư mục chạy.
DB_URL=jdbc:h2:file:./data/game_db;DB_CLOSE_DELAY=-1;MODE=MySQL;CASE_INSENSITIVE_IDENTIFIERS=TRUE
DB_USER=sa
DB_PASSWORD=
GAME_DEMO_SEED_ENABLED=false
WS_ALLOWED_ORIGINS=*
# JavaFX: -Dscribble.server=localhost:8080 (có ô nhập địa chỉ trong ứng dụng).
